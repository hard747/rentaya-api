          "name": "Cotizar: Luis, auto, 7 días = 604.80",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alquileres/cotizacion?clienteId={{idLuis}}&vehiculoId={{idAuto}}&dias=7",
              "host": [
