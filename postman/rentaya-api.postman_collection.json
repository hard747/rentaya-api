{
  "info": {
    "name": "rentaya-api",
    "description": "Cenários da API de gestão de frota. Rode na ordem (Collection Runner) com o ambiente 'rentaya-local' e a tabela limpa.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Crear auto (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/vehiculos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "vehiculos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo\": \"AUTO\",\n  \"placa\": \"TST-101\",\n  \"marca\": \"Toyota\",\n  \"modelo\": \"Corolla\",\n  \"anio\": 2022,\n  \"tarifaDiariaBase\": 120.0,\n  \"numeroPuertas\": 4\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Header Location\", () => pm.response.to.have.header(\"Location\"));",
              "pm.test(\"Kilometraje inicial 0.00\", () => pm.expect(pm.response.text()).to.include('\"kilometraje\":0.00'));",
              "pm.collectionVariables.set(\"idAuto\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
